# ---- 密钥与环境变量（严禁提交；连接串/凭证仅 .env） ----
.env

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# ---- Node / 前端构建 ----
node_modules/
dist/
frontend/dist/

# ---- 运行时数据 ----
backend/exports/
backend/backups/

# ---- 一次性验收脚本（开发期临时写在 backend/ 根目录、跑完即弃；与 offline 仓同纪律） ----
# 注意：backend/tests/integration/*.py 是「常驻集成测试」——有幂等清理 + 退出码，且 ci.yml 的
# probe job 引用其中四个作真库门禁，**必须入库**，不在本条范围内。两类都叫「探针」，
# 判据是「能否被 CI 反复执行」而非名字（口径详见 CONTRIBUTING.md「提交纪律」）。
backend/verify_*.py
backend/run_*.py
backend/trigger_*.py
backend/expand_*.py
backend/fix_*.py
backend/gen_*.py
backend/gold_*.py
backend/monitor_*.py
backend/metrics_s5_*.py
backend/s5out.txt
acceptance-*.md

# ---- 本地工具痕迹 ----
.claude/
.codegraph/
*.log
