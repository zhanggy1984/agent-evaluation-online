# 复制为 .env 填入真实值；.env 严禁提交（.gitignore）。
# 字段 ↔ backend/app/core/config.py（pydantic-settings 大小写不敏感）。dev 底座端点见 docs/infra-access-matrix.md §3。

# ---- 运行 ----
APP_ENV=dev            # dev / test / prod（test 跳过密钥强校验）
RESOURCE_ENV=dev       # 共享 infra 租户前缀 {env}.：库/ topic / index / consumer group 均带

# ---- MySQL（库 = {RESOURCE_ENV}.obs，本地共享 infra，见 #71 落权） ----
# 宿主直连端口 = 共享 infra 宿主映射（infra 仓 MYSQL_PORT，默认 33061）；容器内经服务名 mysql:3306
DB_HOST=localhost
DB_PORT=33061
DB_USER=obs_backend
# DB_NAME 缺省 = {RESOURCE_ENV}.obs；显式则优先
DB_NAME=
DB_PASSWORD=
# alembic DDL 专用账号（成对时用，缺省回退 DB_USER）
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# ---- Elasticsearch 8.x（宿主直连 = 共享 infra 宿主映射 ES_HTTP_PORT，默认 39200；容器内经 elasticsearch:9200） ----
ES_URL=http://localhost:39200

# ---- Kafka（宿主直连 = 共享 infra 宿主映射 KAFKA_PORT，默认 39092；容器内经 kafka:19092） ----
KAFKA_BOOTSTRAP=localhost:39092
# 缺省 = {RESOURCE_ENV}.obs.consumer
KAFKA_CONSUMER_GROUP=

# ---- 密钥（强校验：JWT ≥32 字节 UTF-8；FERNET 逗号分隔多代） ----
JWT_SECRET=
FERNET_KEYS=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- 引导 admin（seed.py init_admin，§13.1；首登后建议改密） ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS（开发期前端源逗号分隔；生产同源置空不注册 CORS 中间件） ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
